# C6 Class Module config
CONFIG_ESP_WIFI_CHANNEL=1
CONFIG_FREERTOS_HZ=1000

# WiFi STA mode
CONFIG_ESP_WIFI_STA_DISCONNECTED_TYPE_ENABLE=y

# SPI Slave config
CONFIG_SPI_SLAVE_IRAM_USED=y

# HTTP client
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# WebSocket client
CONFIG_WS_TRANSPORT_WEBSOCKET=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
