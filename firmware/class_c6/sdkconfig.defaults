# C6 Class Module config
CONFIG_ESP_WIFI_CHANNEL=1
CONFIG_FREERTOS_HZ=1000

# WiFi STA mode
CONFIG_ESP_WIFI_STA_DISCONNECTED_TYPE_ENABLE=y

# SPI Slave config
CONFIG_SPI_SLAVE_IRAM_USED=y

# HTTP client
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# WebSocket client
CONFIG_WS_TRANSPORT_WEBSOCKET=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Flash: DIO works on every C6 module; QIO needs a flash chip with the QE bit
# set and failed to boot on the v3 demo boards (adopted from v3).
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# OTA (#34): an updated image must confirm itself (Wi-Fi + backend + SPI)
# or the bootloader rolls back to the previous one. Changes the bootloader:
# the first C6 flash with this setting must be over serial.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
