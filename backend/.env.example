# Copy to backend/.env (read from the directory you start uvicorn in).
# All settings use the IMPRESS_ prefix; see app/config.py for the full list.

# REQUIRED unless IMPRESS_DEBUG=true — generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
IMPRESS_JWT_SECRET=
IMPRESS_DEVICE_API_KEY=          # must match CONFIG_DEVICE_API_KEY / NVS "api_key" on every C6
# true: the shared key above works for registration only; devices use the key
# they are issued at registration (all devices on firmware with per-device keys).
IMPRESS_DEVICE_KEYS_REQUIRED=false

# First-run super admin password. Leave empty to have a random one generated
# and printed ONCE in the server log on the very first start.
IMPRESS_INITIAL_ADMIN_PASSWORD=

# Local development only: allows the public default secrets above.
IMPRESS_DEBUG=false
IMPRESS_SQL_ECHO=false

# JSON list of browser origins allowed by CORS (the vanilla UI is same-origin).
IMPRESS_CORS_ORIGINS=["http://localhost:5173"]

# Signed firmware (#66): the PUBLIC key from scripts/firmware_key.sh. Set it and
# only images signed with that key are accepted and deployed.
# IMPRESS_FIRMWARE_SIGNING_KEY=/home/impress/.impress/firmware-signing/signing_key.pub
# Without a signing key nothing is deployed unless you accept unsigned images (#123):
# IMPRESS_FIRMWARE_ALLOW_UNSIGNED=true
# One administrator only: let a super admin approve their own firmware uploads (#123):
# IMPRESS_FIRMWARE_SINGLE_APPROVER=true
# IMPRESS_DATABASE_URL=sqlite+aiosqlite:///./impress.db
# IMPRESS_WS_REQUIRE_AUTH=true
# HTTPS is required for staff traffic unless IMPRESS_DEBUG=true (#152). Isolated lab only:
# IMPRESS_REQUIRE_HTTPS=false
# Proxies whose X-Forwarded-Proto is trusted (scripts/start.sh):
# IMPRESS_FORWARDED_ALLOW_IPS=127.0.0.1

# Sessions (v2.2): a session ends after this many minutes without activity; staff
# whose class is in session get the longer limit. One device per account: a second
# sign-in from another device is refused (false turns that off).
# IMPRESS_SESSION_IDLE_MINUTES=5
# IMPRESS_SESSION_CLASS_IDLE_MINUTES=30
# IMPRESS_SINGLE_SESSION=true
# Database integrity (v2.2): the start-up and rolling backups go here (default: the
# system temporary folder) and the database is verified this often (seconds).
# IMPRESS_TEMP_BACKUP_DIR=/temp/backups
# IMPRESS_INTEGRITY_INTERVAL_S=300
