# Copy to backend/.env (read from the directory you start uvicorn in).
# All settings use the IMPRESS_ prefix; see app/config.py for the full list.

# REQUIRED unless IMPRESS_DEBUG=true — generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
IMPRESS_JWT_SECRET=
IMPRESS_DEVICE_API_KEY=          # must match CONFIG_DEVICE_API_KEY / NVS "api_key" on every C6

# First-run super admin password. Leave empty to have a random one generated
# and printed ONCE in the server log on the very first start.
IMPRESS_INITIAL_ADMIN_PASSWORD=

# Local development only: allows the public default secrets above.
IMPRESS_DEBUG=false
IMPRESS_SQL_ECHO=false

# JSON list of browser origins allowed by CORS (the vanilla UI is same-origin).
IMPRESS_CORS_ORIGINS=["http://localhost:5173"]

# IMPRESS_DATABASE_URL=sqlite+aiosqlite:///./impress.db
# IMPRESS_WS_REQUIRE_AUTH=true
